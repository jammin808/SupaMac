# What the operator gives the deploy tool together with compose.yaml.
# Placeholders only: every value here is an address, a name or an image
# reference. No secret belongs in this list; those live in /etc/supamac on
# the VPS (README.md).

# The host name the API is served at, https://<SUPAMAC_API_HOST>. Its DNS
# record points at the VPS. It shares a registrable domain with
# SUPAMAC_UI_ORIGIN (session cookies are strict), and is set before the first
# start: the identity server's issuer and redirects are written from it once.
SUPAMAC_API_HOST=api.example.com

# The domain mail is sent from, unless SUPAMAC_MAIL_DOMAIN names another.
SUPAMAC_DOMAIN=example.com

# Where the web bundle is published: the exact origin browsers send, and the
# folder below it (the bundle is always built for a folder, never the root).
SUPAMAC_UI_ORIGIN=https://example.com
SUPAMAC_UI_PATH=/supamac

# The only addresses that can create an account, as a JSON array.
SUPAMAC_SIGNUP_ALLOWLIST_JSON=["owner@example.com","teammate@example.com"]

# Accounts that get the paid-plan roles after their first sign-in,
# comma-separated.
SUPAMAC_OWNER_EMAILS=owner@example.com

# The domain mail is sent from, when it is not SUPAMAC_DOMAIN. The SMTP
# provider in secrets.env must accept it as a sender.
#SUPAMAC_MAIL_DOMAIN=mail.example.com

# Images, built and pushed by the fork's GitHub Actions. Use immutable
# references (a commit tag or a digest): a new ops image is what makes the
# containers that read its config restart.
SUPAMAC_SERVICES_IMAGE=ghcr.io/example/supamac-services:0000000
SUPAMAC_OPS_IMAGE=ghcr.io/example/supamac-ops:0000000
SUPAMAC_SYNC_IMAGE=ghcr.io/example/supamac-sync:0000000
SUPAMAC_LEXICAL_IMAGE=ghcr.io/example/supamac-lexical:0000000
SUPAMAC_AI_EDITING_IMAGE=ghcr.io/example/supamac-ai-editing:0000000

# Optional parts: email, search, or both (comma-separated). The search
# profile needs its image. With both, the memory limits add up to 15.3 GB,
# more than a 16 GB server that also runs another application has left;
# none of the limits is measured yet (README.md, Profiles).
#COMPOSE_PROFILES=email,search
#SUPAMAC_SEARCH_IMAGE=ghcr.io/example/supamac-search:0000000

# How many daily backups to keep (default 7).
#SUPAMAC_BACKUP_KEEP=7
